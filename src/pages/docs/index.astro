---
import ProductLayout from "../../layouts/ProductLayout.astro";
import { SYSTEM_GROUPS, CAPABILITIES, STATUS_LABEL, GITHUB_URL } from "../../config/portal";

const ACCESS_LABEL: Record<string, string> = {
  public: "公开",
  staff: "需登录",
};

const cnGroup = SYSTEM_GROUPS.find((g) => g.key === "cn");
const globalGroup = SYSTEM_GROUPS.find((g) => g.key === "global");
const envPairs = (cnGroup?.items ?? []).map((cn, i) => ({
  name: cn.name,
  cn: cn.host,
  global: globalGroup?.items[i]?.host ?? "—",
}));
---

<ProductLayout
  title="开发文档 — airdb.dev 研发门户"
  description="airdb 研发门户的公开文档：环境约定、系统台账、门户能力状态与文档维护方式。"
  path="/docs/"
>
  <div class="shell page-hero">
    <p class="notice">公开层文档 · 无需登录 · 内部系统请经 SSO 进入对应子域</p>
    <h1>开发文档</h1>
    <p class="lede">
      这里是研发门户的公开文档：环境与域名约定、系统台账，以及各能力的当前状态。
      有不清楚的地方，写信告诉我们：<a href="mailto:info@airdb.com">info@airdb.com</a>。
    </p>
    <nav class="toc" aria-label="本页目录">
      <a href="#environments">环境约定</a>
      <a href="#systems">系统台账</a>
      <a href="#status">能力状态</a>
      <a href="#contribute">维护方式</a>
    </nav>
  </div>

  <div class="shell doc-body">
    <section class="doc-section" id="environments">
      <h2><span class="sec-no">01 · 约定</span>环境约定</h2>
      <p>
        <strong>国内走 airdb.net（已备案），海外走 airdb.dev</strong>（<code>.dev</code>
        无法 ICP 备案，仅部署海外节点）。两边系统一一对应，域名按环境切换、路径保持一致。
      </p>
      <div class="table-scroll">
        <table class="doc-table">
          <thead>
            <tr>
              <th scope="col">系统</th>
              <th scope="col">国内（airdb.net）</th>
              <th scope="col">海外（airdb.dev / airdb.io）</th>
            </tr>
          </thead>
          <tbody>
            {envPairs.map((p) => (
              <tr>
                <td>{p.name}</td>
                <td><code>{p.cn}</code></td>
                <td><code>{p.global}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="doc-section" id="systems">
      <h2><span class="sec-no">02 · 台账</span>系统台账</h2>
      <p>
        域名与系统的权威来源是仓库里的 <code>src/config/portal.ts</code>，
        本页与首页的系统导航都从它渲染，改台账只改那一处。
      </p>
      {SYSTEM_GROUPS.map((g) => (
        <>
          <h3>{g.title} <small>· {g.note}</small></h3>
          <div class="table-scroll">
            <table class="doc-table">
              <thead>
                <tr>
                  <th scope="col">系统</th>
                  <th scope="col">域名</th>
                  <th scope="col">访问</th>
                </tr>
              </thead>
              <tbody>
                {g.items.map((it) => (
                  <tr>
                    <td>{it.name}{it.status ? `（${STATUS_LABEL[it.status]}）` : ""}</td>
                    <td><a href={it.url} rel="noopener"><code>{it.host}</code></a></td>
                    <td>
                      <span class:list={["pill", it.access === "public" && "pill-live"]}>
                        {ACCESS_LABEL[it.access]}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
    </section>

    <section class="doc-section" id="status">
      <h2><span class="sec-no">03 · 状态</span>能力状态</h2>
      <p>
        门户各能力的当前状态。标注「筹备中」的部分上线后会在本页开出对应文档入口，
        在那之前请以各仓库的 README 为准。
      </p>
      <div class="table-scroll">
        <table class="doc-table">
          <thead>
            <tr>
              <th scope="col">能力</th>
              <th scope="col">说明</th>
              <th scope="col">状态</th>
            </tr>
          </thead>
          <tbody>
            {CAPABILITIES.map((c) => (
              <tr>
                <td>{c.href ? <a href={c.href}>{c.title}</a> : c.title}</td>
                <td>{c.copy}</td>
                <td>
                  <span class:list={["pill", c.status === "live" && "pill-live"]}>
                    {STATUS_LABEL[c.status]}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="doc-section" id="contribute">
      <h2><span class="sec-no">04 · 维护</span>文档维护方式</h2>
      <p>
        本站是静态站点（Astro），源码在
        <a href={`${GITHUB_URL}-site`} rel="noopener">GitHub</a>。更新文档的方式：
      </p>
      <p>
        系统台账、能力清单 → 改 <code>src/config/portal.ts</code>；
        本页正文 → 改 <code>src/pages/docs/index.astro</code>。
        push 到 main 后由 CI 自动构建部署，国内外环境同源发布。
      </p>
    </section>
  </div>
</ProductLayout>
