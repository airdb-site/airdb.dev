---
// airdb.dev — 研发门户首页（公开层：文档入口 + 系统导航 + 权限说明）。
import ProductLayout from "../layouts/ProductLayout.astro";
import { SYSTEM_GROUPS, CAPABILITIES, STATUS_LABEL, SSO_URL, GITHUB_URL } from "../config/portal";

const STATS = [
  { value: "2", label: "套访问环境 · 国内 + 海外" },
  { value: "3", label: "类核心系统 · SSO / BBS / XAdmin" },
  { value: "2", label: "处代码托管 · GitHub + Gitee" },
  { value: "1", label: "个登录入口 · 统一 SSO" },
];

const ACCESS_BADGE: Record<string, string> = {
  public: "公开",
  staff: "员工",
};
---

<ProductLayout
  title="airdb.dev — 研发门户 · 文档与内部系统导航"
  description="airdb 团队的研发门户：公开的开发者文档与教程，组件库与运维手册，以及国内外内部系统的统一导航。内部系统经 sso.airdb.dev 登录。"
  path="/"
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-field" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">airdb.dev · 研发门户</p>
        <h1 class="reveal">
          所有研发资产，<br />
          <span class="ital">一个入口</span>。
        </h1>
        <p class="lede reveal">
          对外，这里是公开的开发文档与教程；对内，这里是组件库、运维手册、CI/CD
          与各内部系统的统一导航。国内走 airdb.net，海外走 airdb.dev，账号统一由 SSO 管理。
        </p>
        <div class="hero-actions reveal">
          <a class="btn btn-solid" href="/docs/">浏览开发文档</a>
          <a class="btn btn-ghost" href={SSO_URL} rel="noopener">员工登录</a>
        </div>
        <p class="hero-note reveal">
          公开文档无需登录 · 内部系统需员工账号 · <span class="mono">sso.airdb.dev</span>
        </p>
      </div>

      <figure class="terminal reveal" aria-label="系统与环境一览">
        <figcaption class="terminal-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="terminal-title mono">airdb — systems</span>
        </figcaption>
        <pre class="mono"><code><span class="t-dim">$</span> airdb systems <span class="t-dim">--env</span> all

<span class="t-dim">NAME     CN · airdb.net      GLOBAL · airdb.dev   ACCESS</span>
<span class="t-key">sso</span>      sso.airdb.net       sso.airdb.dev        <span class="t-num">staff</span>
<span class="t-key">bbs</span>      bbs.airdb.net       bbs.airdb.dev        <span class="t-str">public</span>
<span class="t-key">xadmin</span>   xadmin.airdb.net    airdb.io/xadmin      <span class="t-num">staff</span>
<span class="t-key">docs</span>     —                   airdb.dev/docs       <span class="t-str">public</span>

<span class="t-dim">4 systems · 2 environments · sso: OK</span></code></pre>
      </figure>
    </div>

    <div class="shell">
      <dl class="stat-strip reveal">
        {STATS.map((s) => (
          <div class="stat">
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ 门户能力 ============ -->
  <section class="platform" id="capabilities">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">门户能力</p>
        <h2>六件事，<span class="ital">一本台账</span>。</h2>
        <p class="section-lede">
          组件库、手册、工具、资产、后台入口——研发日常要找的东西，都从这里出发。
          状态如实标注：没上线，就写筹备中。
        </p>
      </header>
      <div class="cap-grid">
        {CAPABILITIES.map((c) => {
          const Tag = c.href ? "a" : "article";
          return (
            <Tag class:list={["cap-card", c.href && "cap-linked"]} href={c.href}>
              <span class="cap-top">
                <span class="cap-no">{c.no}</span>
                <span class:list={["cap-status", `is-${c.status}`]}>{STATUS_LABEL[c.status]}</span>
              </span>
              <h3>{c.title}{c.href && <span class="cap-arrow" aria-hidden="true"> →</span>}</h3>
              <p>{c.copy}</p>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ 系统导航（资产台账） ============ -->
  <section class="systems" id="systems">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">系统导航</p>
        <h2>资产台账，<span class="ital">以此页为准</span>。</h2>
        <p class="section-lede">
          域名与系统的权威清单。缺项、换域名、下线，直接提 issue 修正——台账错了比没有更糟。
        </p>
      </header>

      <div class="ledger">
        {SYSTEM_GROUPS.map((g) => (
          <div class="sys-group">
            <div class="sys-head">
              <h3>{g.title}</h3>
              <span class="mono sys-note">{g.note}</span>
            </div>
            <ul class="sys-list">
              {g.items.map((item) => (
                <li>
                  <a href={item.url} rel="noopener">
                    <span class="sys-name">{item.name}</span>
                    <span class="mono sys-host">{item.host}</span>
                    <span class="sys-badges">
                      <span class:list={["sys-badge", `is-${item.access}`]}>{ACCESS_BADGE[item.access]}</span>
                      {item.status === "migrating" && <span class="sys-badge is-migrating">迁移中</span>}
                    </span>
                    <span class="sys-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 权限模型 ============ -->
  <section class="access" id="access">
    <div class="shell access-grid">
      <div class="access-copy">
        <p class="eyebrow eyebrow-light">权限模型</p>
        <h2>公开的归公开，<span class="ital">内部的归内部</span>。</h2>
        <p>
          门户本身是纯静态站点，不做登录；所有需要鉴权的能力都放在 SSO 之后的子域里。
          公开层可以放心缓存与索引，内部层的边界也更清楚。
        </p>
        <p class="access-note mono">
          注：.dev 域名无法 ICP 备案，airdb.dev 仅部署海外节点；
          国内环境部署在已备案的 airdb.net，两边系统一一对应。
        </p>
      </div>
      <div class="tier-stack">
        <div class="tier">
          <span class="tier-tag mono">PUBLIC · 无需账号</span>
          <h3>公开层</h3>
          <ul>
            <li>开发文档与教程（/docs）</li>
            <li>资产台账与系统导航（本页）</li>
            <li>BBS 论坛（浏览）</li>
            <li>GitHub / Gitee 开源仓库</li>
          </ul>
        </div>
        <div class="tier tier-staff">
          <span class="tier-tag mono">STAFF · SSO 登录</span>
          <h3>内部层</h3>
          <ul>
            <li>管理后台 XAdmin</li>
            <li>埋点统计与数据看板</li>
            <li>CI/CD 流水线</li>
            <li>内部文档与组件库（筹备中）</li>
          </ul>
          <a class="btn btn-paper tier-btn" href={SSO_URL} rel="noopener">前往 SSO 登录</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-band">
    <div class="shell cta-inner">
      <h2>台账有<span class="ital">缺漏</span>？</h2>
      <p>系统换了域名、文档写错了、缺一个入口——提个 issue，或者直接改。</p>
      <div class="hero-actions">
        <a class="btn btn-paper" href={GITHUB_URL} rel="noopener">GitHub 提 Issue</a>
        <a class="btn btn-ghost-light" href={SSO_URL} rel="noopener">员工登录</a>
      </div>
    </div>
  </section>

  <style>
    /* 中文标题不用合成斜体，保留强调色即可 */
    h1 .ital,
    h2 .ital {
      font-style: normal;
    }

    /* ---- 能力卡片：状态标签 ---- */
    a.cap-card {
      display: block;
      text-decoration: none;
      color: inherit;
    }
    .cap-top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }
    .cap-status {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      border: 1px solid var(--rule);
      border-radius: 999px;
      padding: 2px 10px;
      color: var(--ink-soft);
      white-space: nowrap;
    }
    .cap-status.is-live { border-color: var(--green); color: var(--green); }
    .cap-status.is-planned { border-color: var(--ochre); color: var(--ochre); }
    .cap-status.is-staff { border-color: var(--ink-soft); }
    .cap-arrow { color: var(--ochre); }
    .cap-linked:hover h3 { color: var(--green); }

    /* ---- 资产台账 ---- */
    .ledger {
      border-top: 1.5px solid var(--ink);
    }
    .sys-group {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 24px;
      padding: 28px 0;
      border-bottom: 1px solid var(--rule);
    }
    .sys-head h3 {
      font-size: 1.15rem;
    }
    .sys-note {
      display: block;
      margin-top: 6px;
      font-size: 0.75rem;
      color: var(--ochre);
    }
    .sys-list {
      list-style: none;
    }
    .sys-list a {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 18px;
      padding: 12px 10px;
      margin: 0 -10px;
      border-radius: 6px;
      text-decoration: none;
      color: inherit;
      border-bottom: 1px dashed var(--rule);
      transition: background 0.15s ease;
    }
    .sys-list li:last-child a { border-bottom: none; }
    .sys-list a:hover { background: var(--paper-deep); }
    .sys-list a:hover .sys-arrow { color: var(--green); transform: translate(2px, -2px); }
    .sys-name { font-weight: 500; font-size: 0.95rem; }
    .sys-host { font-size: 0.8rem; color: var(--ink-soft); overflow-wrap: anywhere; }
    .sys-badges { display: flex; gap: 6px; }
    .sys-badge {
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      border: 1px solid var(--rule);
      border-radius: 999px;
      padding: 2px 9px;
      color: var(--ink-soft);
      white-space: nowrap;
    }
    .sys-badge.is-public { border-color: var(--green); color: var(--green); }
    .sys-badge.is-staff { border-color: var(--ink-soft); background: var(--paper-deep); }
    .sys-badge.is-migrating { border-color: var(--ochre); color: var(--ochre); }
    .sys-arrow {
      color: var(--ink-soft);
      font-family: var(--mono);
      transition: color 0.15s ease, transform 0.15s ease;
    }

    /* ---- 权限模型（深色段） ---- */
    .access {
      background: var(--terminal);
      color: #d9efe0;
    }
    .access-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 64px;
      align-items: start;
    }
    .access h2 {
      color: #f2faf4;
      font-size: clamp(1.9rem, 3.4vw, 2.5rem);
      margin-bottom: 18px;
    }
    .access h2 .ital { color: var(--phosphor); }
    .access-copy p { color: #a8c4b2; max-width: 36em; }
    .access-note {
      margin-top: 22px;
      font-size: 0.78rem;
      line-height: 1.7;
      color: var(--moss);
      border-left: 2px solid var(--amber);
      padding-left: 14px;
    }
    .tier-stack { display: grid; gap: 20px; }
    .tier {
      border: 1px solid var(--terminal-line);
      border-radius: 10px;
      background: #0a1811;
      padding: 26px 28px 30px;
    }
    .tier-staff {
      border-color: var(--amber);
      box-shadow: 6px 8px 0 color-mix(in srgb, var(--amber) 24%, transparent);
    }
    .tier-tag {
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      color: var(--moss);
    }
    .tier-staff .tier-tag { color: var(--amber); }
    .tier h3 {
      color: #f2faf4;
      font-size: 1.25rem;
      margin: 10px 0 14px;
    }
    .tier ul { list-style: none; display: grid; gap: 9px; }
    .tier li {
      position: relative;
      padding-left: 24px;
      font-size: 0.92rem;
      color: #cfe9d8;
    }
    .tier li::before {
      content: "▪";
      position: absolute;
      left: 0;
      color: var(--amber);
    }
    .tier-btn { margin-top: 22px; display: inline-block; }

    @media (max-width: 960px) {
      .sys-group { grid-template-columns: 1fr; gap: 12px; }
      .access-grid { grid-template-columns: 1fr; gap: 40px; }
      .sys-list a { grid-template-columns: 1fr auto; grid-template-rows: auto auto; }
      .sys-host { grid-column: 1; grid-row: 2; }
      .sys-badges { grid-column: 2; grid-row: 1; justify-self: end; }
      .sys-arrow { grid-column: 2; grid-row: 2; justify-self: end; }
    }
  </style>

  <script>
    // Scroll-triggered reveals outside the hero
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.01, rootMargin: "0px 0px -8% 0px" }
    );
    document
      .querySelectorAll(".cap-card, .sys-group, .tier, .section-head")
      .forEach((el) => {
        el.classList.add("will-reveal");
        observer.observe(el);
      });
  </script>
</ProductLayout>
